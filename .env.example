# Shared secret for worker -> API internal routes (must match api and worker services)
INTERNAL_TOKEN=dev-internal-change-me

# AI provider: "ollama" (local) or "cloud" (any OpenAI-compatible API)
# AI_PROVIDER=ollama

# --- Ollama (local) ---
# Ollama model to use for diagram analysis (must support vision/multimodal input)
# Run 'docker-compose exec ollama ollama pull gemma4' or set OLLAMA_MODEL and restart ollama-pull
OLLAMA_MODEL=gemma4
# OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Cloud (any OpenAI-compatible provider: OpenRouter, OpenAI, Together, Groq, etc.) ---
# CLOUD_BASE_URL=https://openrouter.ai/api/v1
# CLOUD_API_KEY=your-key-here
# CLOUD_MODEL=google/gemma-4-31b-it:free

# MinIO (defaults match docker-compose; override for non-compose runs)
# MINIO_ENDPOINT=minio:9000
# MINIO_ACCESS_KEY=minio
# MINIO_SECRET_KEY=minio12345
# MINIO_BUCKET=hackathon
# MINIO_USE_SSL=false

# Optional: only used when running seed locally against DATABASE_URL
# SEED_CLIENT_NAME=demo
# SEED_TOKEN_BALANCE=100000
