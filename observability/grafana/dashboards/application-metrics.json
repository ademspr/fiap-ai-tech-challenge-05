  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "reqps" },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "id": 2,
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (method, path_group, endpoint, http_status) (rate(http_responses_total{path_group=~\"$path_group\",method=~\"$method\"}[5m]))",
          "legendFormat": "{{method}} {{endpoint}} {{http_status}}",
          "refId": "A"
        }
      ],
      "title": "HTTP responses / s by method, endpoint template & HTTP status",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "decimals": 1,
          "min": 0,
          "unit": "ms",
          "custom": {
            "axisBorderShow": false,
            "axisPlacement": "auto",
            "drawStyle": "line",
            "lineWidth": 1,
            "stacking": { "group": "A", "mode": "none" }
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": "^p95 " },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": { "dash": [10, 10] }
              }
            ]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "id": 3,
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "1000 * sum(rate(http_request_latency_seconds_sum{path_group=~\"$path_group\",method=~\"$method\"}[5m])) by (method, path_group, endpoint) / sum(rate(http_request_latency_seconds_count{path_group=~\"$path_group\",method=~\"$method\"}[5m])) by (method, path_group, endpoint)",
          "legendFormat": "mean {{method}} {{endpoint}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "1000 * histogram_quantile(0.95, sum(rate(http_request_latency_seconds_bucket{path_group=~\"$path_group\",method=~\"$method\"}[5m])) by (le, method, path_group, endpoint))",
          "legendFormat": "p95 {{method}} {{endpoint}}",
          "refId": "B"
        }
      ],
      "title": "API HTTP latency mean & p95 by method + endpoint template",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 24, "x": 0, "y": 16 },
      "id": 11,
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
        "showUnfilled": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum by (method, path_group, endpoint, http_status) (increase(http_responses_total{path_group=~\"$path_group\",method=~\"$method\"}[$__range]))",
          "instant": true,
          "legendFormat": "{{method}} {{endpoint}} {{http_status}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "HTTP responses by method, endpoint & status (count in dashboard time range)",
      "type": "bargauge"
